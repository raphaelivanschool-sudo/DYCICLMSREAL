generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  role        Role
  fullName    String
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sessions       Session[]
  tickets        Ticket[]
  approvedTickets Ticket[] @relation("TicketApprover")
  assignedTickets Ticket[] @relation("TicketAssignee")
  systemLogs     SystemLog[]
  messages       Message[]
  sentMessages   Message[] @relation("SentMessages")
  assignedLaboratories Laboratory[]
  labSchedules   LabSchedule[]
  createdGroups  Group[]
  groupMemberships GroupMember[]
  // Grading module
  sections        Section[]       @relation("InstructorSections")
  enrollments     Enrollment[]    @relation("StudentEnrollments")
  gradedScores    Score[]         @relation("ScoreGrader")
  gradeAuditLogs  GradeAuditLog[]
  agentActivityLogs AgentActivityLog[]
}

model Laboratory {
  id          Int      @id @default(autoincrement())
  name        String
  location    String?
  building    String?  // Building A, Building B, etc.
  roomNumber  String
  capacity    Int
  status      LabStatus @default(ACTIVE)
  assignedInstructorId Int?
  // Schedule-based assignment fields
  scheduleDay     String?  // Monday, Tuesday, etc.
  scheduleTimeSlot String? // 1:00 PM - 3:00 PM, etc.
  scheduleClass   String?  // BSIT 3A, etc.
  scheduleSubjectCode String? // AIA 313, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  computers  Computer[]
  hardwareInventoryItems HardwareInventory[]
  sessions   Session[]
  assignedInstructor User? @relation(fields: [assignedInstructorId], references: [id])
  schedules  LabSchedule[]
}

model Computer {
  id              Int      @id @default(autoincrement())
  name            String
  seatNumber      Int?
  ipAddress       String?
  macAddress      String?
  status          ComputerStatus @default(OFFLINE)
  isLocked        Boolean  @default(false)
  laboratoryId    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Hardware Specifications
  processor       String?  // CPU model
  ram             String?  // RAM size (e.g., "16GB")
  storageType     String?  // SSD or HDD
  storageSize     String?  // Storage size (e.g., "512GB")
  gpu             String?  // GPU model (optional)
  osVersion       String?  // Operating System version
  
  // Relations
  laboratory Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  sessionStudents SessionStudent[]
  software  ComputerSoftware[]
  hardwareInventoryItems HardwareInventory[]
}

model Session {
  id              Int      @id @default(autoincrement())
  name            String
  instructorId    Int
  laboratoryId    Int
  startTime       DateTime
  endTime         DateTime?
  status          SessionStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  instructor      User             @relation(fields: [instructorId], references: [id])
  laboratory      Laboratory       @relation(fields: [laboratoryId], references: [id])
  sessionStudents SessionStudent[]
}

model SessionStudent {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  studentId   Int
  computerId  Int
  checkInTime DateTime @default(now())
  checkOutTime DateTime?
  status      StudentSessionStatus @default(ACTIVE)

  // Relations
  session   Session   @relation(fields: [sessionId], references: [id])
  computer  Computer  @relation(fields: [computerId], references: [id])
}

model Ticket {
  id          Int      @id @default(autoincrement())
  ticketId    String   @unique // Format: T-2025-001
  title       String
  description String   @db.Text
  status      TicketStatus @default(PENDING_APPROVAL)
  priority    TicketPriority @default(MEDIUM)
  category    String
  createdBy   Int
  assignedTo  Int?
  approvedBy  Int?
  approvedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  creator     User     @relation(fields: [createdBy], references: [id])
  assignee    User?    @relation("TicketAssignee", fields: [assignedTo], references: [id])
  approver    User?    @relation("TicketApprover", fields: [approvedBy], references: [id])
}

model SystemLog {
  id          Int      @id @default(autoincrement())
  action      String
  description String?
  userId      Int?
  ipAddress   String?
  createdAt   DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [userId], references: [id])
}

model Message {
  id          Int      @id @default(autoincrement())
  content     String   @db.Text
  senderId    Int
  receiverId  Int?
  groupId     Int?
  isBroadcast Boolean  @default(false)
  status      MessageStatus @default(SENT)
  attachments String?  @db.Text // JSON array of file URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User?    @relation(fields: [receiverId], references: [id])
  group       Group?   @relation(fields: [groupId], references: [id])
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  creator     User     @relation(fields: [createdBy], references: [id])
  members     GroupMember[]
  messages    Message[]
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  userId    Int
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  // Relations
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum GroupRole {
  ADMIN
  MEMBER
}

model HardwareInventory {
  id              Int      @id @default(autoincrement())
  name            String
  deviceType      DeviceType
  model           String?
  serialNumber    String   @unique
  condition       Condition @default(GOOD)
  status          HardwareStatus @default(ACTIVE)
  notes           String?  @db.Text
  laboratoryId    Int
  assignedComputerId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  laboratory      Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  assignedComputer Computer? @relation(fields: [assignedComputerId], references: [id])
}

model Inventory {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  quantity    Int      @default(0)
  unit        String
  location    String?
  status      InventoryStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum LabStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ComputerStatus {
  ONLINE
  OFFLINE
  IN_USE
  IDLE
  MAINTENANCE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StudentSessionStatus {
  ACTIVE
  COMPLETED
  ABSENT
}

enum TicketStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
  DEPLETED
}

enum DeviceType {
  MONITOR
  CPU
  KEYBOARD
  MOUSE
  HEADSET
  WEBCAM
  UPS
  PRINTER
  OTHER
}

enum Condition {
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum HardwareStatus {
  ACTIVE
  INACTIVE
  UNDER_REPAIR
  MISSING
}

// Lab Schedule for instructor assignments
model LabSchedule {
  id              Int      @id @default(autoincrement())
  laboratoryId    Int
  day             String   // Monday, Tuesday, etc.
  startTime       String   // 13:00 (24-hour format)
  endTime         String   // 15:00 (24-hour format)
  instructorId    Int
  className       String   // BSIT 3A, etc.
  subjectCode     String   // AIA 313, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  laboratory      Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  instructor      User       @relation(fields: [instructorId], references: [id])
  sections        Section[]
}

// Computer Software tracking
model ComputerSoftware {
  id              Int      @id @default(autoincrement())
  computerId      Int
  softwareName    String
  version         String?
  installedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  computer        Computer   @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@unique([computerId, softwareName])
}

// ============================================================
// Grading Module — per-semester, 1.00–5.00 model
// (3.00 = lowest passing at 75%, <75% = 5.00, INC supported, no 4.00)
// ============================================================

// The time container. Grades are given per semester.
model Semester {
  id        Int            @id @default(autoincrement())
  name      String         // e.g. "1st Sem AY 2025-2026"
  isActive  Boolean        @default(false)
  status    SemesterStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  sections  Section[]
}

// A course in the catalog. Units matter for GWA.
model Subject {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  title     String
  units     Float    @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  Section[]
}

// An offering: a Subject taught by an instructor in a Semester.
model Section {
  id            Int      @id @default(autoincrement())
  name          String   // e.g. "BSIT 3A"
  subjectId     Int
  instructorId  Int
  semesterId    Int
  labScheduleId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  instructor  User         @relation("InstructorSections", fields: [instructorId], references: [id])
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  labSchedule LabSchedule? @relation(fields: [labScheduleId], references: [id])

  enrollments Enrollment[]
  categories  GradeCategory[]

  @@unique([subjectId, semesterId, name])
}

// A student's record in a section: holds the final grade for that subject that semester.
model Enrollment {
  id              Int         @id @default(autoincrement())
  sectionId       Int
  studentId       Int
  finalPercentage Float?
  gradePoint      Float?      // transmuted 1.00–5.00, null until computed (or if INC)
  isInc           Boolean     @default(false)
  gradeStatus     GradeStatus @default(IN_PROGRESS)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student User    @relation("StudentEnrollments", fields: [studentId], references: [id])
  scores  Score[]

  @@unique([sectionId, studentId])
}

// Weighted bucket per section (e.g. Class Standing 30, Laboratory 30, ...).
model GradeCategory {
  id        Int      @id @default(autoincrement())
  sectionId Int
  name      String
  weight    Float    // percent; weights sum to 100 per section
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  activities Activity[]
}

// A gradeable item within a category.
model Activity {
  id            Int       @id @default(autoincrement())
  categoryId    Int
  title         String
  maxScore      Float     @default(100)
  dueDate       DateTime?
  labScheduleId Int?      // optional link to a lab session/schedule
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category GradeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scores   Score[]
}

// One student's mark on one activity.
model Score {
  id           Int       @id @default(autoincrement())
  activityId   Int
  enrollmentId Int
  rawScore     Float?
  feedback     String?   @db.Text
  gradedById   Int?
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("ScoreGrader", fields: [gradedById], references: [id])

  @@unique([activityId, enrollmentId])
}

// Configurable transmutation table: { minPercent..maxPercent -> gradePoint }.
model GradeScale {
  id         Int     @id @default(autoincrement())
  minPercent Float
  maxPercent Float
  gradePoint Float
  label      String?
}

// Accountability trail for grade-affecting actions.
model GradeAuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  entityType String?
  entityId   Int?
  detail     String?  @db.Text
  oldValue   String?
  newValue   String?
  reason     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}

enum SemesterStatus {
  OPEN
  LOCKED
}

enum GradeStatus {
  IN_PROGRESS
  SUBMITTED
  LOCKED
}

// Agent PC Control models
model Agent {
  id              Int             @id @default(autoincrement())
  hostname        String
  ipAddress       String
  mac             String          @unique
  platform        String
  status          AgentStatus     @default(OFFLINE)
  lastSeen        DateTime?
  registeredAt    DateTime        @default(now())
  activityLogs    AgentActivityLog[]

  @@index([status])
  @@index([lastSeen])
}

model AgentActivityLog {
  id          Int           @id @default(autoincrement())
  agentId     Int
  agent       Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  command     String
  issuedBy    Int
  user        User          @relation(fields: [issuedBy], references: [id])
  timestamp   DateTime      @default(now())
  status      LogStatus     @default(SENT)

  @@index([agentId])
  @@index([timestamp])
}

enum AgentStatus {
  ONLINE
  OFFLINE
}

enum LogStatus {
  SENT
  EXECUTED
  FAILED
}
