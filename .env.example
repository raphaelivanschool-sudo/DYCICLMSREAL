# Root .env — used by the Vite frontend and the Prisma CLI.
# Copy to .env and fill in real values:  cp .env.example .env
# (Vite only exposes variables prefixed with VITE_.)

# URLs the dashboard uses to reach the backend API + Socket.IO.
# Local dev: leave as localhost.
VITE_API_URL="http://localhost:3001"
VITE_SOCKET_URL="http://localhost:3001"

# Database used by the Prisma CLI (migrate / seed / studio).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/labmanagement"
