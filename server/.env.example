# server/.env — used by the Express + Socket.IO backend.
# Copy to server/.env and fill in real values:  cp server/.env.example server/.env

# Database the API connects to (same database as the root .env DATABASE_URL).
DATABASE_URL="mysql://root:@localhost:3306/labmanagement"

# Secret used to sign/verify JWT auth tokens. Use a long, random string.
JWT_SECRET="change-me-to-a-long-random-string"

# API port (the guest agents and dashboard connect here).
PORT=3001
# Dashboard origin allowed by CORS.
CLIENT_URL="http://localhost:5173"
NODE_ENV=development

# Shared secret for the server -> guest Python agent HTTP API (Flask on port 5555).
# MUST match "api_key" in each guest's agent/pc-agent/python/agent_config.json.
PC_AGENT_API_KEY="change-me-shared-agent-key"
PC_AGENT_HTTP_PORT=5555
# PC_AGENT_CONFIG_PATH=   # optional: read the agent api_key from a JSON file instead of env

# ── Locked Demo Mode (screen projection) tunables ────────────────────────────
PROJECTION_FPS=12                     # 5–20  target capture/broadcast frame rate
PROJECTION_JPEG_QUALITY=60            # 30–85 JPEG quality (bandwidth vs. clarity)
PROJECTION_MAX_WIDTH=1280             # max frame width (preserves aspect ratio)
PROJECTION_WATCHDOG_SECONDS=8         # 3–60  guest auto-unlocks if no frames arrive
PROJECTION_RESEND_TO_LATE_JOINERS=true
# PROJECTION_DEBUG=false              # verbose per-hop projection logging
